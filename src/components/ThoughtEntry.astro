---
import type { CollectionEntry } from 'astro:content';
import { clock, isoUtc, relativeTime, stamp } from '../lib/date';
import { url } from '../lib/site';

interface Props {
  thought: CollectionEntry<'thoughts'>;
}

const { thought } = Astro.props;
const paragraphs = thought.body!
  .split(/\n{2,}/)
  .map((block) => block.trim())
  .filter(Boolean);
const iso = isoUtc(thought.data.createdAt);
const printed = clock(thought.data.createdAt);
const relative = relativeTime(thought.data.createdAt);
const tagBase = url('thoughts/');
---

<article
  id={thought.id}
  data-item
  data-tags={thought.data.tags.join(' ')}
  class="scroll-mt-24 border-b border-line py-5 last:border-b-0"
>
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] text-muted">
    <time datetime={iso} title={stamp(thought.data.createdAt)} class="tabular-nums">{printed}</time>
    <span aria-hidden="true">/</span>
    <span>{relative}</span>

    {
      thought.data.tags.length > 0 && (
        <span class="ml-auto flex flex-wrap items-center gap-x-2.5 gap-y-1">
          {thought.data.tags.map((tag) => (
            <a
              href={`${tagBase}?tag=${encodeURIComponent(tag)}`}
              class="transition-colors hover:text-accent"
            >
              #{tag}
            </a>
          ))}
        </span>
      )
    }
  </div>

  <div class="mt-1.5 space-y-2 text-[16px] leading-[1.85] text-ink">
    {paragraphs.map((block) => <p class="whitespace-pre-line">{block}</p>)}
  </div>
</article>
