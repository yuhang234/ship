---
/**
 * 文章编辑器：标题、摘要、分类、标签、封面、Markdown 正文 + 实时预览。
 * 保存与发布都通过 GitHub Contents API 直接写入仓库，
 * 输入过程自动存草稿到 IndexedDB，关闭页面也不会丢。
 */
import StudioLayout from '../../layouts/StudioLayout.astro';
import { url } from '../../lib/site';

const categories = ['随笔', '技术', '电影', '阅读', '生活'];
---

<StudioLayout title="写文章">
  <div slot="actions" class="studio-actions">
    <a class="btn btn-ghost btn-sm" href={url('studio/')}>← 写作台</a>
  </div>

  <div class="write-page" data-role="page" data-view="split">
    <header class="write-head">
      <div class="write-head-meta">
        <span class="studio-badge" data-role="status">草稿</span>
        <span class="studio-note" data-role="auth-note">检查登录状态…</span>
      </div>

      <input
        class="title-input"
        type="text"
        data-role="title"
        placeholder="标题"
        aria-label="文章标题"
        autocomplete="off"
        maxlength="120"
      />

      <div class="permalink-line">
        <span class="mono">永久链接</span>
        <code class="permalink-value" data-role="permalink">/ship/writing/…/</code>
        <button class="btn btn-ghost btn-sm" type="button" data-role="rename">修改</button>
        <span class="permalink-edit" data-role="rename-box" hidden>
          <input class="field" type="text" data-role="rename-input" aria-label="新的链接片段" />
          <button class="btn btn-sm" type="button" data-role="rename-apply">确定</button>
          <button class="btn btn-ghost btn-sm" type="button" data-role="rename-cancel">取消</button>
        </span>
      </div>
    </header>

    <details class="meta-panel" data-role="meta">
      <summary class="studio-disclosure">摘要、分类、标签、日期、封面</summary>
      <div class="meta-grid">
        <div class="field-group">
          <label class="field-label" for="article-description">摘要</label>
          <textarea
            class="field field-textarea"
            id="article-description"
            data-role="description"
            rows="2"
            placeholder="一两句话说明这篇在说什么（可选，用于列表与分享卡片）"
          ></textarea>
        </div>

        <div class="field-row">
          <div class="field-group">
            <label class="field-label" for="article-category">分类</label>
            <input
              class="field"
              id="article-category"
              data-role="category"
              type="text"
              value="随笔"
              list="category-options"
            />
            <datalist id="category-options">
              {categories.map((category) => <option value={category} />)}
            </datalist>
          </div>

          <div class="field-group">
            <label class="field-label" for="article-date">发布日期（北京时间）</label>
            <input class="field" id="article-date" data-role="date" type="datetime-local" />
          </div>
        </div>

        <div class="field-group">
          <label class="field-label" for="article-tags">标签</label>
          <div class="tagbox" data-role="tagbox">
            <span class="chips" data-role="chips"></span>
            <input
              class="field"
              id="article-tags"
              data-role="tag-input"
              type="text"
              placeholder="输入后回车添加，例：写作"
              autocomplete="off"
            />
          </div>
        </div>

        <div class="field-group">
          <label class="field-label" for="article-cover">封面图</label>
          <div class="field-row">
            <input
              class="field"
              id="article-cover"
              data-role="cover"
              type="text"
              placeholder="站内路径或图片地址（可选）"
            />
            <button class="btn btn-sm" type="button" data-role="cover-upload">上传图片</button>
            <button class="btn btn-ghost btn-sm" type="button" data-role="cover-clear">清除</button>
          </div>
        </div>

        <p class="studio-note" data-role="draft-note" hidden></p>
      </div>
    </details>

    <div class="tabbar" role="tablist" aria-label="编辑器视图">
      <button class="tab-btn" type="button" role="tab" data-view="edit" aria-selected="false">编辑</button>
      <button class="tab-btn" type="button" role="tab" data-view="split" aria-selected="true">分栏</button>
      <button class="tab-btn" type="button" role="tab" data-view="preview" aria-selected="false">预览</button>
    </div>

    <div class="editor-shell">
      <div class="editor-toolbar" data-role="toolbar" role="toolbar" aria-label="Markdown 工具栏">
        <button class="tool-btn" type="button" data-action="bold" title="加粗"><strong>B</strong></button>
        <button class="tool-btn" type="button" data-action="italic" title="斜体"><em>I</em></button>
        <button class="tool-btn" type="button" data-action="strike" title="删除线"><s>S</s></button>
        <span class="tool-sep" aria-hidden="true"></span>
        <button class="tool-btn" type="button" data-action="code" title="行内代码">`</button>
        <button class="tool-btn" type="button" data-action="codeblock" title="代码块">{ }</button>
        <button class="tool-btn" type="button" data-action="quote" title="引用">”</button>
        <span class="tool-sep" aria-hidden="true"></span>
        <button class="tool-btn" type="button" data-action="h2" title="二级标题">H2</button>
        <button class="tool-btn" type="button" data-action="ul" title="无序列表">•</button>
        <button class="tool-btn" type="button" data-action="ol" title="有序列表">1.</button>
        <span class="tool-sep" aria-hidden="true"></span>
        <button class="tool-btn" type="button" data-action="link" title="链接">链</button>
        <button class="tool-btn" type="button" data-action="image" title="插入图片">图</button>
        <button class="tool-btn" type="button" data-action="hr" title="分割线">—</button>
        <span class="tool-sep" aria-hidden="true"></span>
        <button class="tool-btn" type="button" data-role="insert-image" title="上传并插入图片">上传图片</button>
      </div>

      <div class="editor-grid">
        <textarea
          class="editor-input"
          data-role="body"
          spellcheck="false"
          aria-label="文章正文（Markdown）"
          placeholder="正文用 Markdown 写。Ctrl/Cmd + S 存草稿，Ctrl/Cmd + Enter 发布。"
        ></textarea>
        <div class="editor-preview prose-ship" data-role="preview" aria-live="polite"></div>
      </div>
    </div>

    <footer class="write-footer">
      <div class="write-footer-meta">
        <span class="mono" data-role="stats">0 字 · 约 1 分钟</span>
        <span class="studio-note" data-role="save-state">尚未保存</span>
      </div>
      <div class="write-footer-actions">
        <button class="btn btn-ghost" type="button" data-role="save-draft">存草稿</button>
        <button class="btn btn-primary" type="button" data-role="publish">发布</button>
      </div>
    </footer>

    <input type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" data-role="image-input" hidden />
    <div class="toast-stack" data-toasts aria-live="assertive" aria-atomic="false"></div>
  </div>

  <style>
    /* 视图切换：编辑 / 分栏 / 预览。桌面默认分栏，移动端默认编辑。 */
    .editor-grid {
      display: grid;
      gap: 0.75rem;
      grid-template-columns: 1fr;
    }

    .write-page[data-view='preview'] .editor-input {
      display: none;
    }

    .write-page[data-view='edit'] .editor-preview {
      display: none;
    }

    @media (min-width: 1024px) {
      .editor-grid {
        grid-template-columns: 1fr 1fr;
        align-items: start;
      }

      .editor-preview {
        position: sticky;
        top: 4.5rem;
        max-height: calc(100dvh - 10rem);
        overflow-y: auto;
      }

      .tabbar {
        display: none;
      }
    }

    .permalink-edit {
      display: inline-flex;
      gap: 0.375rem;
      align-items: center;
    }

    .permalink-edit .field {
      width: 16rem;
      min-height: 2.25rem;
    }
  </style>
</StudioLayout>

<script>
  import { getSession, isOAuthConfigured, restoreSession, signIn } from '../../lib/auth';
  import { REPO } from '../../lib/site';
  import { toParts } from '../../lib/date';
  import { applyFormat, bindShortcuts, countStats, renderPreview, type ToolbarAction } from '../../lib/editor';
  import { deleteDraft, getDraft, saveDraft, type Draft } from '../../lib/idb';
  import {
    deleteArticle,
    loadArticles,
    loadThoughts,
    saveArticle,
    slugFor,
    uploadImage,
    type ArticleRecord,
  } from '../../lib/studio-api';
  import { url } from '../../lib/site';
  import { normalizeTags } from '../../lib/text';

  /* ---------- DOM ---------- */

  function must<T extends Element>(selector: string): T {
    const element = document.querySelector<T>(selector);
    if (!element) throw new Error(`页面缺少元素：${selector}`);
    return element;
  }

  const page = must<HTMLDivElement>('[data-role="page"]');
  const titleInput = must<HTMLInputElement>('[data-role="title"]');
  const descriptionInput = must<HTMLTextAreaElement>('[data-role="description"]');
  const categoryInput = must<HTMLInputElement>('[data-role="category"]');
  const dateInput = must<HTMLInputElement>('[data-role="date"]');
  const coverInput = must<HTMLInputElement>('[data-role="cover"]');
  const bodyInput = must<HTMLTextAreaElement>('[data-role="body"]');
  const previewBox = must<HTMLDivElement>('[data-role="preview"]');
  const tagInput = must<HTMLInputElement>('[data-role="tag-input"]');
  const chipsBox = must<HTMLSpanElement>('[data-role="chips"]');
  const statusBadge = must<HTMLSpanElement>('[data-role="status"]');
  const permalink = must<HTMLElement>('[data-role="permalink"]');
  const authNote = must<HTMLSpanElement>('[data-role="auth-note"]');
  const statsBox = must<HTMLSpanElement>('[data-role="stats"]');
  const saveState = must<HTMLSpanElement>('[data-role="save-state"]');
  const draftNote = must<HTMLParagraphElement>('[data-role="draft-note"]');
  const renameBox = must<HTMLSpanElement>('[data-role="rename-box"]');
  const renameInput = must<HTMLInputElement>('[data-role="rename-input"]');
  const imageInput = must<HTMLInputElement>('[data-role="image-input"]');
  const toastStack = document.querySelector<HTMLDivElement>('[data-toasts]');
  const saveDraftButton = must<HTMLButtonElement>('[data-role="save-draft"]');
  const publishButton = must<HTMLButtonElement>('[data-role="publish"]');

  /* ---------- 状态 ---------- */

  interface FormState {
    title: string;
    description: string;
    category: string;
    tags: string[];
    body: string;
    /** datetime-local 值，语义为北京时间 */
    dateLocal: string;
    cover: string;
    published: boolean;
    slug: string;
    path: string;
    sha: string;
    loading: boolean;
    saving: boolean;
    dirty: boolean;
  }

  const state: FormState = {
    title: '',
    description: '',
    category: '随笔',
    tags: [],
    body: '',
    dateLocal: '',
    cover: '',
    published: false,
    slug: '',
    path: '',
    sha: '',
    loading: true,
    saving: false,
    dirty: false,
  };

  const now = new Date();
  const initialParts = toParts(now);
  const pad = (value: number): string => String(value).padStart(2, '0');
  const defaultDateLocal = `${initialParts.year}-${pad(initialParts.month)}-${pad(initialParts.day)}T${pad(
    initialParts.hour,
  )}:${pad(initialParts.minute)}`;

  function messageOf(error: unknown): string {
    if (error instanceof Error && error.message) return error.message;
    return '操作失败，请稍后再试';
  }

  function toast(text: string, tone: 'ok' | 'error' = 'error', link?: { href: string; label: string }): void {
    if (!toastStack) return;
    const box = document.createElement('div');
    box.className = 'toast';
    box.dataset.tone = tone;
    box.setAttribute('role', 'status');

    const content = document.createElement('div');
    content.className = 'toast-text';
    content.textContent = text;
    if (link) {
      const anchor = document.createElement('a');
      anchor.href = link.href;
      anchor.textContent = link.label;
      anchor.target = '_blank';
      anchor.rel = 'noopener noreferrer';
      content.append(' ', anchor);
    }

    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'toast-close';
    close.setAttribute('aria-label', '关闭提示');
    close.textContent = '×';
    close.addEventListener('click', () => box.remove());

    box.append(content, close);
    toastStack.append(box);
    window.setTimeout(() => box.remove(), tone === 'error' ? 8000 : 5000);
  }

  /* ---------- 表单读写 ---------- */

  function dateLocalToIso(value: string): string {
    const normalized = value.trim();
    if (!normalized) return new Date().toISOString();
    const withSeconds = normalized.length === 16 ? `${normalized}:00` : normalized;
    const parsed = new Date(`${withSeconds}+08:00`);
    return Number.isNaN(parsed.getTime()) ? new Date().toISOString() : parsed.toISOString();
  }

  function isoToDateLocal(iso: string): string {
    const parts = toParts(iso);
    return `${parts.year}-${pad(parts.month)}-${pad(parts.day)}T${pad(parts.hour)}:${pad(parts.minute)}`;
  }

  function renderTagChips(): void {
    chipsBox.textContent = '';
    for (const tag of state.tags) {
      const chip = document.createElement('span');
      chip.className = 'chip';
      chip.textContent = tag;
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'chip-remove';
      remove.setAttribute('aria-label', `移除标签 ${tag}`);
      remove.textContent = '×';
      remove.addEventListener('click', () => {
        state.tags = state.tags.filter((item) => item !== tag);
        renderTagChips();
        markDirty();
      });
      chip.append(remove);
      chipsBox.append(chip);
    }
  }

  function refreshPreview(): void {
    previewBox.innerHTML = renderPreview(state.body);
  }

  function refreshStats(): void {
    const stats = countStats(state.body);
    statsBox.textContent = `${stats.words} 字 · 约 ${stats.minutes} 分钟`;
  }

  function refreshPermalink(): void {
    const slug = state.slug || (state.title.trim() ? slugFor(state.title, new Date(dateLocalToIso(state.dateLocal))) : '');
    permalink.textContent = slug ? url(`writing/${slug}/`) : url('writing/…/');
    statusBadge.textContent = state.published ? '已发布' : '草稿';
    statusBadge.dataset.tone = state.published ? 'accent' : '';
  }

  function setSaveState(text: string): void {
    saveState.textContent = text;
  }

  function markDirty(): void {
    state.dirty = true;
    setSaveState('尚未保存');
    refreshPreview();
    refreshStats();
    refreshPermalink();
    scheduleAutosave();
  }

  /* ---------- 草稿自动保存 ---------- */

  let autosaveTimer = 0;

  function draftKey(): string {
    return `article:${state.slug || 'new'}`;
  }

  function buildDraft(): Draft {
    return {
      key: draftKey(),
      kind: 'article',
      updatedAt: Date.now(),
      title: state.title,
      payload: {
        title: state.title,
        description: state.description,
        category: state.category,
        tags: state.tags,
        body: state.body,
        dateLocal: state.dateLocal,
        cover: state.cover,
        published: state.published,
        slug: state.slug,
      },
      remotePath: state.path || undefined,
      remoteSha: state.sha || undefined,
    };
  }

  function scheduleAutosave(): void {
    window.clearTimeout(autosaveTimer);
    autosaveTimer = window.setTimeout(() => {
      void (async () => {
        try {
          await saveDraft(buildDraft());
          setSaveState(`草稿已本地保存 ${new Date().toLocaleTimeString('zh-CN', { hour12: false })}`);
        } catch {
          setSaveState('本地草稿保存失败（浏览器存储不可用）');
        }
      })();
    }, 1200);
  }

  /* ---------- 读取远端 ---------- */

  function applyRecord(record: ArticleRecord): void {
    state.title = record.title;
    state.description = record.description;
    state.category = record.category || '随笔';
    state.tags = [...record.tags];
    state.body = record.body;
    state.dateLocal = isoToDateLocal(record.pubDate);
    state.cover = record.cover ?? '';
    state.published = record.published;
    state.slug = record.slug;
    state.path = record.path;
    state.sha = record.sha;

    titleInput.value = state.title;
    descriptionInput.value = state.description;
    categoryInput.value = state.category;
    dateInput.value = state.dateLocal;
    coverInput.value = state.cover;
    bodyInput.value = state.body;

    renderTagChips();
    refreshPreview();
    refreshStats();
    refreshPermalink();
    setSaveState('已载入仓库中的文章');
    state.dirty = false;
  }

  async function loadFromQuery(): Promise<void> {
    const params = new URLSearchParams(window.location.search);
    const slug = params.get('slug');
    const from = params.get('from');

    if (slug) {
      const articles = await loadArticles();
      const record = articles.find((article) => article.slug === slug);
      if (!record) {
        toast(`没有找到文章：${slug}`);
        return;
      }
      applyRecord(record);
      return;
    }

    if (from) {
      const thoughts = await loadThoughts();
      const thought = thoughts.find((item) => item.id === from);
      if (thought) {
        state.body = thought.body;
        bodyInput.value = thought.body;
        state.tags = [...thought.tags];
        renderTagChips();
        const parts = toParts(thought.createdAt);
        state.dateLocal = `${parts.year}-${pad(parts.month)}-${pad(parts.day)}T${pad(parts.hour)}:${pad(parts.minute)}`;
        dateInput.value = state.dateLocal;
        setSaveState('已从想法转入初稿');
      }
    }
  }

  async function restoreDraft(): Promise<void> {
    try {
      const draft = await getDraft(draftKey());
      if (!draft) return;
      const payload = draft.payload as Partial<FormState>;
      if (!payload.body && !payload.title) return;
      draftNote.hidden = false;
      draftNote.textContent = `发现 ${new Date(draft.updatedAt).toLocaleString('zh-CN', { hour12: false })} 的本地草稿。`;

      const restore = document.createElement('button');
      restore.type = 'button';
      restore.className = 'btn btn-sm';
      restore.textContent = '恢复';
      restore.addEventListener('click', () => {
        state.title = String(payload.title ?? '');
        state.description = String(payload.description ?? '');
        state.category = String(payload.category ?? '随笔');
        state.tags = Array.isArray(payload.tags) ? payload.tags.map(String) : [];
        state.body = String(payload.body ?? '');
        state.dateLocal = String(payload.dateLocal ?? defaultDateLocal);
        state.cover = String(payload.cover ?? '');
        state.published = Boolean(payload.published);
        state.path = draft.remotePath ?? '';
        state.sha = draft.remoteSha ?? '';

        titleInput.value = state.title;
        descriptionInput.value = state.description;
        categoryInput.value = state.category;
        dateInput.value = state.dateLocal;
        coverInput.value = state.cover;
        bodyInput.value = state.body;

        renderTagChips();
        refreshPreview();
        refreshStats();
        refreshPermalink();
        markDirty();
        toast('已恢复本地草稿', 'ok');
      });

      const discard = document.createElement('button');
      discard.type = 'button';
      discard.className = 'btn btn-ghost btn-sm';
      discard.textContent = '丢弃';
      discard.addEventListener('click', () => {
        void deleteDraft(draftKey());
        draftNote.hidden = true;
        draftNote.textContent = '';
      });

      draftNote.append(' ', restore, ' ', discard);
    } catch {
      /* IndexedDB 不可用时静默降级 */
    }
  }

  /* ---------- 保存 / 发布 ---------- */

  function syncFromInputs(published: boolean): void {
    state.title = titleInput.value;
    state.description = descriptionInput.value;
    state.category = categoryInput.value;
    state.dateLocal = dateInput.value || defaultDateLocal;
    state.cover = coverInput.value;
    state.body = bodyInput.value;
    state.published = published;
  }

  async function persist(published: boolean): Promise<void> {
    if (state.saving) return;
    syncFromInputs(published);

    if (!getSession()) {
      toast('请先登录 GitHub 再保存');
      return;
    }

    if (!state.title.trim()) {
      toast('请先填写标题');
      titleInput.focus();
      return;
    }

    state.saving = true;
    saveDraftButton.disabled = true;
    publishButton.disabled = true;
    setSaveState(published ? '正在发布…' : '正在保存草稿…');

    try {
      const nextSlug = state.slug || slugFor(state.title, new Date(dateLocalToIso(state.dateLocal)));
      const record = await saveArticle({
        title: state.title,
        description: state.description,
        category: state.category,
        tags: normalizeTags(state.tags),
        body: state.body,
        published,
        pubDate: dateLocalToIso(state.dateLocal),
        cover: state.cover,
        sha: state.sha || undefined,
        path: state.path || undefined,
      });

      state.slug = record.slug;
      state.path = record.path;
      state.sha = record.sha;
      state.published = record.published;
      state.dirty = false;

      if (nextSlug && record.slug && nextSlug !== record.slug) {
        permalink.textContent = url(`writing/${record.slug}/`);
      }
      refreshPermalink();
      await deleteDraft(draftKey()).catch(() => undefined);
      setSaveState(`已提交 ${new Date().toLocaleTimeString('zh-CN', { hour12: false })}`);

      const actionsUrl = `https://github.com/${REPO.fullName}/actions`;
      toast(published ? '已发布，约 1 分钟后可在线查看' : '草稿已保存（未发布）', 'ok', {
        href: actionsUrl,
        label: '查看部署',
      });

      if (published && !window.location.search.includes('slug=')) {
        window.history.replaceState(null, '', `${window.location.pathname}?slug=${encodeURIComponent(record.slug)}`);
      }
    } catch (error) {
      setSaveState('保存失败');
      toast(messageOf(error));
    } finally {
      state.saving = false;
      saveDraftButton.disabled = false;
      publishButton.disabled = false;
    }
  }

  /* ---------- 工具栏与快捷键 ---------- */

  function runAction(action: ToolbarAction, value?: string): void {
    const result = applyFormat(bodyInput, action, value);
    bodyInput.value = result.text;
    bodyInput.focus();
    bodyInput.setSelectionRange(result.selectionStart, result.selectionEnd);
    state.body = result.text;
    markDirty();
  }

  document.querySelector('[data-role="toolbar"]')?.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-action]');
    if (!button) return;
    event.preventDefault();
    const action = button.dataset.action as ToolbarAction | undefined;
    if (!action) return;

    if (action === 'link' || action === 'image') {
      const raw = window.prompt(action === 'link' ? '链接地址' : '图片地址（可先点“上传图片”）', 'https://');
      if (!raw) return;
      runAction(action, raw.trim());
      return;
    }

    runAction(action);
  });

  bindShortcuts(document.body, {
    save: () => void persist(false),
    publish: () => void persist(true),
  });

  bodyInput.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || event.isComposing) return;
    event.preventDefault();
    const start = bodyInput.selectionStart ?? 0;
    const end = bodyInput.selectionEnd ?? start;
    bodyInput.value = `${bodyInput.value.slice(0, start)}  ${bodyInput.value.slice(end)}`;
    bodyInput.setSelectionRange(start + 2, start + 2);
    markDirty();
  });

  /* ---------- 图片上传 ---------- */

  let uploadTarget: 'body' | 'cover' = 'body';

  async function handleImage(file: File): Promise<void> {
    try {
      setSaveState('正在上传图片…');
      const src = await uploadImage(file);
      if (uploadTarget === 'cover') {
        coverInput.value = src;
        state.cover = src;
      } else {
        runAction('image', src);
      }
      toast('图片已上传', 'ok');
      setSaveState('图片已上传，记得保存文章');
    } catch (error) {
      toast(messageOf(error));
      setSaveState('图片上传失败');
    }
  }

  imageInput.addEventListener('change', () => {
    const file = imageInput.files?.[0];
    if (file) void handleImage(file);
    imageInput.value = '';
  });

  must<HTMLButtonElement>('[data-role="insert-image"]').addEventListener('click', () => {
    uploadTarget = 'body';
    imageInput.click();
  });

  must<HTMLButtonElement>('[data-role="cover-upload"]').addEventListener('click', () => {
    uploadTarget = 'cover';
    imageInput.click();
  });

  must<HTMLButtonElement>('[data-role="cover-clear"]').addEventListener('click', () => {
    coverInput.value = '';
    state.cover = '';
    markDirty();
  });

  /* ---------- 重命名链接 ---------- */

  const oldPathForRename = { value: '' };

  must<HTMLButtonElement>('[data-role="rename"]').addEventListener('click', () => {
    if (!state.sha) {
      toast('文章还没有保存过，链接会在首次保存时自动生成');
      return;
    }
    oldPathForRename.value = state.path;
    renameInput.value = state.slug;
    renameBox.hidden = false;
    renameInput.focus();
  });

  must<HTMLButtonElement>('[data-role="rename-cancel"]').addEventListener('click', () => {
    renameBox.hidden = true;
  });

  must<HTMLButtonElement>('[data-role="rename-apply"]').addEventListener('click', () => {
    const next = renameInput.value
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9-]+/g, '-')
      .replace(/^-+|-+$/g, '');
    if (!next) {
      toast('链接只能包含小写字母、数字和连字符');
      return;
    }
    if (next === state.slug) {
      renameBox.hidden = true;
      return;
    }
    if (!getSession()) {
      toast('请先登录 GitHub');
      return;
    }

    const oldSlug = state.slug;
    void (async () => {
      try {
        state.slug = next;
        state.path = '';
        state.sha = '';
        await persist(state.published);

        const articles = await loadArticles();
        const previous = articles.find((item) => item.slug === oldSlug);
        if (previous && previous.slug !== state.slug) {
          await deleteArticle(previous);
        }

        renameBox.hidden = true;
        toast('链接已修改，旧链接在下次部署后失效', 'ok');
      } catch (error) {
        toast(messageOf(error));
      }
    })();
  });

  /* ---------- 标签 ---------- */

  function commitTag(): void {
    const raw = tagInput.value.trim();
    if (!raw) return;
    state.tags = normalizeTags([...state.tags, raw]);
    tagInput.value = '';
    renderTagChips();
    markDirty();
  }

  tagInput.addEventListener('keydown', (event) => {
    if (event.isComposing) return;
    if (event.key !== 'Enter' && event.key !== ',' && event.key !== '，') return;
    event.preventDefault();
    commitTag();
  });

  tagInput.addEventListener('blur', () => {
    if (tagInput.value.trim()) commitTag();
  });

  /* ---------- 输入联动 ---------- */

  const watched: Array<HTMLInputElement | HTMLTextAreaElement> = [
    titleInput,
    descriptionInput,
    categoryInput,
    dateInput,
    coverInput,
    bodyInput,
  ];

  for (const element of watched) {
    element.addEventListener('input', () => markDirty());
  }

  /* ---------- 视图切换（移动端） ---------- */

  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));

  function setView(view: string): void {
    page.dataset.view = view;
    for (const button of tabButtons) {
      button.setAttribute('aria-selected', String(button.dataset.view === view));
    }
  }

  for (const button of tabButtons) {
    button.addEventListener('click', () => {
      const view = button.dataset.view;
      if (view) setView(view);
    });
  }

  if (window.matchMedia('(max-width: 1023px)').matches) setView('edit');

  /* ---------- 登录状态 ---------- */

  function refreshAuth(): void {
    const session = getSession();
    authNote.textContent = '';

    if (session) {
      authNote.textContent = `已登录：${session.login}`;
      return;
    }

    if (!isOAuthConfigured()) {
      authNote.textContent = '登录服务未配置：可以先写草稿，设置 PUBLIC_OAUTH_BASE 后才能提交。';
      return;
    }

    const loginButton = document.createElement('button');
    loginButton.type = 'button';
    loginButton.className = 'btn btn-sm';
    loginButton.textContent = '登录 GitHub';
    loginButton.addEventListener('click', () => {
      void (async () => {
        try {
          const next = await signIn();
          refreshAuth();
          toast(`已登录：${next.login}`, 'ok');
        } catch (error) {
          toast(messageOf(error));
        }
      })();
    });

    authNote.append('尚未登录，', loginButton, ' 后即可保存。');
  }

  /* ---------- 离开提醒 ---------- */

  window.addEventListener('beforeunload', (event) => {
    if (!state.dirty) return;
    event.preventDefault();
    event.returnValue = '';
  });

  /* ---------- 启动 ---------- */

  async function start(): Promise<void> {
    dateInput.value = defaultDateLocal;
    state.dateLocal = defaultDateLocal;
    state.loading = false;
    await restoreSession();
    refreshAuth();
    refreshStats();
    refreshPreview();
    refreshPermalink();
    setSaveState('尚未保存');

    try {
      await loadFromQuery();
    } catch (error) {
      toast(messageOf(error));
    }

    await restoreDraft();
  }

  void start();
</script>