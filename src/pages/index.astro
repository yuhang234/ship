---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ThoughtEntry from '../components/ThoughtEntry.astro';
import EmptyState from '../components/EmptyState.astro';
import { SITE, url } from '../lib/site';

const posts = (await getCollection('writing', ({ data }) => data.published)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const thoughts = (await getCollection('thoughts')).sort(
  (a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf(),
);

const latestPosts = posts.slice(0, 3);
const latestThoughts = thoughts.slice(0, 5);

/** 把一句话介绍拆成两行短句，避免首页铺垫过长。 */
const introLines = SITE.description
  .split('：')
  .map((line) => line.trim())
  .filter(Boolean);
---

<BaseLayout title="ship">
  <div class="container-list">
    <section class="pt-12 pb-8 sm:pt-16">
      <h1 class="font-serif text-[28px] leading-none font-semibold tracking-tight sm:text-[30px]">
        ship
      </h1>
      <p class="mt-3 text-[15px] text-ink">{SITE.tagline}</p>
      <p class="mt-1.5 max-w-[30rem] text-[14px] leading-[1.8] text-muted">
        {introLines.map((line) => <span class="block">{line}</span>)}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[14px]">
        <a
          href={url('studio/')}
          class="text-ink underline decoration-line decoration-1 underline-offset-4 transition-colors hover:decoration-accent"
        >
          写下想法 →
        </a>
        <a
          href={url('writing/')}
          class="text-ink underline decoration-line decoration-1 underline-offset-4 transition-colors hover:decoration-accent"
        >
          读文章 →
        </a>
        <span class="ml-auto flex items-center gap-4 text-[13px] text-muted">
          <a href={url('archives/')} class="transition-colors hover:text-ink">归档</a>
          <a href={url('search/')} class="transition-colors hover:text-ink">搜索</a>
        </span>
      </div>
    </section>

    <section class="mt-6 border-t border-line pt-8">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-[13px] tracking-[0.08em] text-muted">最新文章</h2>
        <a href={url('writing/')} class="text-[13px] text-muted transition-colors hover:text-ink">
          全部文章 →
        </a>
      </div>

      <div class="mt-2">
        {
          latestPosts.length > 0 ? (
            latestPosts.map((post) => <PostCard post={post} />)
          ) : (
            <EmptyState
              title="还没有文章"
              description="先写第一篇吧，哪怕只有三段。"
              href={url('studio/')}
              actionLabel="开始写作"
            />
          )
        }
      </div>
    </section>

    <section class="mt-10 border-t border-line pt-8">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-[13px] tracking-[0.08em] text-muted">最新想法</h2>
        <a href={url('thoughts/')} class="text-[13px] text-muted transition-colors hover:text-ink">
          全部想法 →
        </a>
      </div>

      <div class="mt-2">
        {
          latestThoughts.length > 0 ? (
            latestThoughts.map((thought) => <ThoughtEntry thought={thought} />)
          ) : (
            <EmptyState
              title="想法区还空着"
              description="随手记一句，不用完整。"
              href={url('studio/')}
              actionLabel="写一条想法"
            />
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>
