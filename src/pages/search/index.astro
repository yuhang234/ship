---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { url } from '../../lib/site';
---

<BaseLayout title="搜索" description="在想法与文章里检索关键词，中英文皆可。" noindex>
  <div class="container-list">
    <header class="pt-12 pb-6 sm:pt-16">
      <h1 class="font-serif text-[26px] leading-tight font-semibold tracking-tight">搜索</h1>
      <p class="mt-2 text-[13px] text-muted">搜想法、搜文章，中文按字匹配，英文按词匹配。</p>
    </header>

    <form data-search-form role="search" action={url('search/')} class="border-b border-line pb-5">
      <label for="search-input" class="sr-only">搜索关键词</label>
      <input
        id="search-input"
        data-search-input
        type="search"
        name="q"
        autofocus
        autocomplete="off"
        enterkeyhint="search"
        placeholder="搜索想法与文章…"
        class="w-full rounded-md border border-line bg-surface px-3 py-2.5 text-[15px] placeholder:text-muted focus:border-ink/30 focus:outline-none"
      />
      <p class="mt-2 text-[12px] text-muted">
        按 <kbd class="rounded border border-line px-1 font-mono text-[11px]">/</kbd> 快速聚焦输入框
      </p>
    </form>

    <p data-hint class="mt-6 text-[14px] text-muted">输入关键词，中英文皆可</p>

    <div data-empty hidden class="mt-6">
      <EmptyState
        title="没有找到相关内容"
        description="换个更短的关键词试试，或者只输入一个字。"
        href={url('thoughts/')}
        actionLabel="按时间翻阅想法"
      />
    </div>

    <p data-count hidden aria-live="polite" class="mt-5 text-[12.5px] text-muted"></p>
    <ol data-results class="mt-1"></ol>
  </div>

  <script>
    import { searchDocs, snippet, type SearchDoc, type SearchHit } from '../../lib/search';
    import { url } from '../../lib/site';

    (() => {
      const form = document.querySelector('[data-search-form]');
      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const list = document.querySelector('[data-results]');
      const hint = document.querySelector<HTMLElement>('[data-hint]');
      const empty = document.querySelector<HTMLElement>('[data-empty]');
      const count = document.querySelector<HTMLElement>('[data-count]');

      if (!form || !input || !list) return;

      let index: SearchDoc[] | null = null;
      let composing = false;
      let timer = 0;
      let sequence = 0;

      const show = (element: HTMLElement | null, visible: boolean) => {
        if (element) element.hidden = !visible;
      };

      const loadIndex = async () => {
        if (index) return index;
        const response = await fetch(url('search.json'));
        if (!response.ok) throw new Error(`索引加载失败：${response.status}`);
        index = (await response.json()) as SearchDoc[];
        return index;
      };

      const makeMeta = (hit: SearchHit) => {
        const meta = document.createElement('p');
        meta.className = 'mt-1 flex flex-wrap items-center gap-x-2 text-[12px] text-muted';

        const kind = document.createElement('span');
        kind.textContent = hit.kind === 'thought' ? '想法' : '文章';
        meta.appendChild(kind);

        const separator = document.createElement('span');
        separator.setAttribute('aria-hidden', 'true');
        separator.textContent = '/';
        meta.appendChild(separator);

        const date = document.createElement('span');
        date.className = 'tabular-nums';
        date.textContent = hit.date;
        meta.appendChild(date);

        if (hit.tags && hit.tags.length > 0) {
          const separatorTwo = document.createElement('span');
          separatorTwo.setAttribute('aria-hidden', 'true');
          separatorTwo.textContent = '/';
          meta.appendChild(separatorTwo);

          const tags = document.createElement('span');
          tags.textContent = hit.tags.slice(0, 3).map((tag) => `#${tag}`).join(' ');
          meta.appendChild(tags);
        }

        return meta;
      };

      const renderHit = (hit: SearchHit, query: string) => {
        const item = document.createElement('li');
        item.className = 'border-b border-line py-4 last:border-b-0';

        const link = document.createElement('a');
        link.href = hit.url;
        link.className = 'block text-[16px] leading-snug font-medium tracking-tight transition-colors hover:text-accent';
        link.textContent =
          hit.kind === 'writing' && hit.title ? hit.title : hit.text.slice(0, 20).trim() || '想法';

        item.appendChild(link);
        item.appendChild(makeMeta(hit));

        const excerpt = document.createElement('p');
        excerpt.className = 'mt-1.5 line-clamp-2 text-[13.5px] leading-relaxed text-muted';
        excerpt.textContent = snippet(hit.text, query);
        item.appendChild(excerpt);

        return item;
      };

      const run = async (rawQuery: string) => {
        const query = rawQuery.trim();
        const current = ++sequence;

        window.history.replaceState(
          {},
          '',
          `${window.location.pathname}${query ? `?q=${encodeURIComponent(query)}` : ''}`,
        );

        list.replaceChildren();
        show(empty, false);
        show(count, false);

        if (!query) {
          show(hint, true);
          return;
        }

        show(hint, false);

        let docs;
        try {
          docs = await loadIndex();
        } catch (error) {
          if (current !== sequence) return;
          show(count, true);
          count!.textContent = '搜索索引暂时不可用，请稍后再试。';
          return;
        }

        if (current !== sequence) return;

        const hits = searchDocs(docs, query, 30);

        if (hits.length === 0) {
          show(empty, true);
          return;
        }

        const fragment = document.createDocumentFragment();
        for (const hit of hits) fragment.appendChild(renderHit(hit, query));
        list.appendChild(fragment);

        show(count, true);
        count!.textContent = `找到 ${hits.length} 条结果`;
      };

      const schedule = () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          void run(input.value);
        }, 250);
      };

      input.addEventListener('compositionstart', () => {
        composing = true;
      });

      input.addEventListener('compositionend', () => {
        composing = false;
        schedule();
      });

      input.addEventListener('input', (event) => {
        if (composing || event.isComposing) return;
        schedule();
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        window.clearTimeout(timer);
        void run(input.value);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
        const active = document.activeElement;
        const tag = active && active.tagName ? active.tagName.toLowerCase() : '';
        if (tag === 'input' || tag === 'textarea' || (active instanceof HTMLElement && active.isContentEditable)) return;
        event.preventDefault();
        input.focus();
        input.select();
      });

      const initial = new URLSearchParams(window.location.search).get('q') || '';
      if (initial) {
        input.value = initial;
        void run(initial);
      }
    })();
  </script>
</BaseLayout>
