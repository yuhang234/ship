---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/site';
---

<BaseLayout title="页面不存在" description="这个地址上没有内容。" noindex>
  <div class="container-reading">
    <div class="pt-24 pb-16 sm:pt-32">
      <p class="text-[12.5px] tracking-[0.08em] text-muted">404</p>
      <h1 class="mt-2 font-serif text-[24px] leading-tight font-semibold tracking-tight sm:text-[26px]">
        这个地址上没有东西
      </h1>
      <p class="mt-3 text-[14.5px] leading-relaxed text-muted">
        可能是链接改了，也可能是内容还没写完。
      </p>

      <nav class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[14px]">
        <a href={url('')} class="underline decoration-line underline-offset-4 transition-colors hover:decoration-accent">回到首页</a>
        <a href={url('thoughts/')} class="text-muted transition-colors hover:text-ink">想法</a>
        <a href={url('writing/')} class="text-muted transition-colors hover:text-ink">文章</a>
        <a href={url('search/')} class="text-muted transition-colors hover:text-ink">搜索</a>
      </nav>
    </div>
  </div>
</BaseLayout>
