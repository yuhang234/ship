# ship 构建期公开变量（全部会在前端可见，不要放任何密钥）
# 本地开发时复制为 .env 并按需修改；GitHub Actions 会自动注入，无需提交 .env。

# 仓库全名 owner/repo，写作后台通过 GitHub API 提交到该仓库
PUBLIC_GITHUB_REPO=owner/ship

# 站点绝对地址，用于 sitemap / RSS / canonical
PUBLIC_SITE_URL=https://owner.github.io

# 内容提交分支
PUBLIC_GITHUB_BRANCH=main

# Cloudflare Worker OAuth 代理地址（留空则写作后台提示未配置登录服务）
PUBLIC_OAUTH_BASE=